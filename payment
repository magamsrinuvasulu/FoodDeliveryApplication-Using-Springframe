package spring;
import java.time.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;
@Component
public class Payment {
	private String payment_id;
	private LocalDateTime payment_date_time;
	private int amount;
	private String payment_status;
	@Autowired
	private Order order;
	public String getPayment_id() {
		return payment_id;
	}
	public void setPayment_id(String payment_id) {
		this.payment_id = payment_id;
	}
	public LocalDateTime getPayment_date_time() {
		return payment_date_time;
	}
	public void setPayment_date_time(LocalDateTime payment_date_time) {
		this.payment_date_time = payment_date_time;
	}
	public int getAmount() {
		return amount;
	}
	public void setAmount(int amount) {
		this.amount = amount;
	}
	public String getPayment_status() {
		return payment_status;
	}
	public void setPayment_status(String payment_status){
		this.payment_status = payment_status;
	}
	public Order getOrder(){
		return order;
	}
	public void setOrder(Order order) {
		this.order = order;
	}
	// Check payment status 
	public void checkPaymentStatus() { 
		if (amount >= order.getTotal_amount()) { 
			payment_status = "Success"; 
		} else 
			{ payment_status = "Failed"; 
		} 
		
	}
	@Override
	public String toString() {
		return "Payment [payment_id=" + payment_id + ", payment_date_time=" + payment_date_time + ", amount=" + amount
				+ ", payment_status=" + payment_status + ", order=" + order + "]";
	}
}
